views:
  - type: table
    name: Daily
    filters:
      and:
        - file.ctime.date() >= date(this.file.name) - duration("3d")
        - file.ctime.date() <= date(this.file.name) + duration("3d")
        - file != this.file
    order:
      - file.name
      - file.ctime
  - type: table
    name: View
